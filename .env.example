# ==============================================================================
# Environment Configuration — Comex Resilient Data Engine V2 (HTAP Profile)
# ==============================================================================

# PostgreSQL 16 (Core Fiduciário ACID & Star Schema)
POSTGRES_USER=htap_user
POSTGRES_PASSWORD=htap_pass
POSTGRES_DB=comex_database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://htap_user:htap_pass@localhost:5433/comex_database

# MongoDB 7 (Landing Zone NoSQL de Payloads Brutos)
# Conecte pelo MongoDB Compass / VS Code em: mongodb://localhost:27017
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=comex_lake
MONGO_URL=mongodb://localhost:27017/comex_lake

# API Server (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# DuckDB OLAP Local Lakehouse
DUCKDB_PATH=./data/comex_lakehouse.duckdb
PARQUET_BASE_DIR=./data/parquet_lakehouse
