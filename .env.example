# ==============================================================================
# Environment Configuration — Comex Resilient Data Engine V2 (HTAP Profile)
# ==============================================================================

# PostgreSQL 16 (Core Fiduciário ACID & Star Schema)
POSTGRES_USER=comex_user
POSTGRES_PASSWORD=comex_pass
POSTGRES_DB=comex_fiduciary_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql://comex_user:comex_pass@localhost:5434/comex_fiduciary_db

# MongoDB 7 (Landing Zone NoSQL de Payloads Brutos — Auth Enabled)
# Conecte pelo MongoDB Compass / VS Code usando MONGO_URL abaixo
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DB=comex_raw_lake
MONGO_INITDB_ROOT_USERNAME=comex_mongo_user
MONGO_INITDB_ROOT_PASSWORD=comex_mongo_pass
MONGO_INITDB_DATABASE=comex_raw_lake
MONGO_URL=mongodb://comex_mongo_user:comex_mongo_pass@localhost:27018/comex_raw_lake?authSource=admin

# API Server & Security (FastAPI)
# Dev/local/CI defaults below — rotate all secrets before staging/production!
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
API_KEY=dev-comex-api-key-local-only
AUDITOR_API_KEY=dev-comex-auditor-key-local-only
PII_HASH_SALT=dev-comex-pii-salt-local-only
RATE_LIMIT_PER_MINUTE=60

# DuckDB OLAP Local Lakehouse
DUCKDB_PATH=./data/comex_lakehouse.duckdb
PARQUET_BASE_DIR=./data/parquet_lakehouse
